# fieldkit configuration template
#
# Copy this file to ".env" and edit as needed:
#
#     cp example.env .env
#
# ".env" is never committed (see .gitignore). Tools read ".env" if it
# exists; every value below has a built-in default, so ".env" is
# optional. Use it to pin tool locations or change defaults per host.
#
# Format: KEY=VALUE, one per line. Blank lines and lines starting with
# "#" are ignored. Surrounding single or double quotes are stripped.


# ===========================================================================
# optical/ — DVD and Blu-ray disc-image tools
# ===========================================================================

# --- External tool locations ------------------------------------------------
# Absolute path to each external binary. Leave blank to find it on PATH.
# Set these only when a tool is installed somewhere non-standard.

FIELDKIT_FFMPEG=
FIELDKIT_FFPROBE=
FIELDKIT_DVDAUTHOR=
FIELDKIT_XORRISO=
FIELDKIT_TSMUXER=

# --- Output and scratch -----------------------------------------------------

# Directory where finished .iso images are written.
# Blank = write the .iso next to the source video file.
FIELDKIT_OUTPUT_DIR=

# Directory for intermediate files (transcoded streams, VIDEO_TS, BDMV).
# Blank = a system temp directory, created and removed automatically.
# Set this to a fast disk with plenty of free space for large jobs.
FIELDKIT_WORK_DIR=

# --- DVD defaults -----------------------------------------------------------

# TV standard used when it cannot be inferred from the source frame rate.
# Allowed: ntsc | pal
FIELDKIT_DVD_STANDARD=ntsc

# Display aspect ratio for the authored DVD.
# Allowed: 4:3 | 16:9
FIELDKIT_DVD_ASPECT=16:9

# --- Blu-ray defaults -------------------------------------------------------

# Vertical resolution for the authored Blu-ray.
# Allowed: 1080 | 720
FIELDKIT_BLURAY_RESOLUTION=1080


# ===========================================================================
# music/ — audio tagging tools
# ===========================================================================

# Optional Discogs personal access token:
#   https://www.discogs.com/settings/developers
# tag_music.py pulls genre data from Discogs without a token, but the
# Discogs cover-art fallback (used when the Cover Art Archive has no
# cover) needs an authenticated request. Leave blank to skip that
# fallback. A FIELDKIT_DISCOGS_TOKEN set in the environment overrides
# this value.
FIELDKIT_DISCOGS_TOKEN=
